# Copy to .env. Everything here is optional — you can also paste keys in Settings → Models.

# Where Tandem is reachable from your browser/phone. Use https:// in production
# (enables Secure cookies, Web Push on iOS, and MCP OAuth callbacks).
TANDEM_PUBLIC_URL=http://localhost:7420

# Encrypts the secret vault. If unset, a random key is generated in the data dir.
# Set it when you want the vault to survive moving the data dir between machines.
# TANDEM_SECRET_KEY=

# Model provider keys (read from the environment if not stored in the vault)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Context compression (https://www.supercompress.dev). Shrinks large tool results before they reach the model.
# SUPERCOMPRESS_API_KEY=

# Web search (first one present wins; DuckDuckGo is the keyless fallback)
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# EXA_API_KEY=
# SEARXNG_URL=

# TANDEM_PORT=7420
# TANDEM_HOST=127.0.0.1
# TANDEM_DATA_DIR=~/.tandem
# TANDEM_BROWSER_PATH=/usr/bin/chromium
# TANDEM_ALLOW_PRIVATE_FETCH=1   # let web tools reach private/LAN addresses (off by default: SSRF guard)
