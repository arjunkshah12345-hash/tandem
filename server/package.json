{
  "name": "@tandem/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "tandem": "./bin/tandem.js" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "croner": "^10.0.1",
    "hono": "^4.13.13",
    "imapflow": "^2.9.0",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.2.1",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/nodemailer": "*",
    "@types/web-push": "*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
